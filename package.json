{
  "name": "@romeohunneaul/protolab",
  "version": "0.1.0",
  "description": "From a feature intent to a running screen, built with the host project's own components.",
  "license": "MIT",
  "type": "module",
  "repository": "github:romeohunneaul/protolab",
  "files": [
    "src",
    "bin",
    "skills",
    "rules"
  ],
  "exports": {
    ".": "./src/index.ts"
  },
  "bin": {
    "protolab-init": "./bin/protolab-init.mjs",
    "protolab-new": "./bin/protolab-new.mjs",
    "protolab-skills": "./bin/protolab-skills.mjs"
  },
  "scripts": {
    "test": "node --test \"test/*.test.mjs\"",
    "typecheck": "npm --prefix examples/next run typecheck",
    "build:example": "npm --prefix examples/next run build",
    "smoke": "playwright test",
    "check": "npm test && npm run typecheck && npm run build:example && npm run smoke"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0"
  },
  "peerDependencies": {
    "next": ">=15",
    "react": ">=19"
  }
}
